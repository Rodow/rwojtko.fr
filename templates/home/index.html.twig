{% extends 'base.html.twig' %}

{% block title %}Rodolphe Wojtkowiak - DevOps / Développeur Web Backend{% endblock %}

{% block body %}
    <div class="bg-shapes">
        <div class="shape"></div>
        <div class="shape"></div>
        <div class="shape"></div>
    </div>

    <!-- Hero -->
    <section class="hero">
        <div class="container">
            <div class="hero-content">
                <img src="/images/photo-rodolphe.jpeg" alt="Rodolphe Wojtkowiak" class="profile-photo">
                <h1>Rodolphe <span>Wojtkowiak</span></h1>
                <p class="subtitle">DevOps / Développeur Web Backend</p>
                <p class="tagline">+5 ans d'expérience en développement web. Passionné, rigoureux, esprit d'équipe.</p>
                <div class="hero-links">
                    <a href="mailto:rodolphewojtko@gmail.com" class="primary">Me contacter</a>
                    <a href="https://www.linkedin.com/in/rodolphe-wojtkowiak" target="_blank" rel="noopener"
                       class="secondary">LinkedIn</a>
                </div>
            </div>
        </div>
        <div class="scroll-indicator">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
            </svg>
        </div>
    </section>

    <!-- Compétences -->
    <section id="skills">
        <div class="container">
            <h2 class="section-title">Compétences</h2>
            <div class="skills-grid" data-controller="skills-rotation" data-skills-rotation-interval-value="5000" data-skills-rotation-count-value="2">
                <div class="skill-category">
                    <h3>DevOps</h3>
                    <div class="skill-tags">
                        <span class="skill-tag--featured skill-tag--ansible">
                            <img src="/images/ansible_logo_black_square.png" alt="Ansible">
                            Ansible
                        </span>
                        <span class="skill-tag--featured skill-tag--docker">
                            <img src="/images/docker.svg" alt="Docker">
                            Docker
                        </span>
                        <span class="skill-tag--featured skill-tag--linux">
                            <img src="/images/linux.svg" alt="Linux">
                            Linux
                        </span>
                        <span class="skill-tag--featured skill-tag--ovhcloud">
                            <img src="/images/ovhcloud.png" alt="OVHCloud">
                            OVHCloud
                        </span>
                        <span class="skill-tag--featured skill-tag--github-actions">
                            <img src="/images/github-actions.svg" alt="GitHub Actions">
                            GitHub Actions
                        </span>
                    </div>
                </div>
                <div class="skill-category">
                    <h3>Monitoring</h3>
                    <div class="skill-tags">
                        <span class="skill-tag--featured skill-tag--grafana">
                            <img src="/images/grafana.svg" alt="Grafana">
                            Grafana
                        </span>
                        <span class="skill-tag--featured skill-tag--prometheus">
                            <img src="/images/prometheus.svg" alt="Prometheus">
                            Prometheus
                        </span>
                        <span class="skill-tag--featured skill-tag--loki">
                            <img src="/images/loki.png" alt="Loki">
                            Loki
                        </span>
                        <span class="skill-tag">Promtail</span>
                        <span class="skill-tag">PMM</span>
                        <span class="skill-tag--featured skill-tag--netdata">
                            <img src="/images/netdata.png" alt="NetData">
                            NetData
                        </span>
                    </div>
                </div>
                <div class="skill-category">
                    <h3>Backend</h3>
                    <div class="skill-tags">
                        <span class="skill-tag--featured skill-tag--php">
                            <img src="/images/php.svg" alt="PHP">
                            PHP
                        </span>
                        <span class="skill-tag--featured skill-tag--symfony">
                            <img src="/images/symfony.svg" alt="Symfony">
                            Symfony
                        </span>
                        <span class="skill-tag--featured skill-tag--scala">
                            <img src="/images/scala.svg" alt="Scala">
                            Scala
                        </span>
                        <span class="skill-tag">API REST</span>
                    </div>
                </div>
                <div class="skill-category">
                    <h3>Base de données</h3>
                    <div class="skill-tags">
                        <span class="skill-tag--featured skill-tag--mysql">
                            <img src="/images/mysql.svg" alt="MySQL">
                            MySQL
                        </span>
                        <span class="skill-tag--featured skill-tag--vitess">
                            <img src="/images/vitess.png" alt="Vitess">
                            Vitess
                        </span>
                        <span class="skill-tag--featured skill-tag--elasticsearch">
                            <img src="/images/elasticsearch.svg" alt="Elasticsearch">
                            Elasticsearch
                        </span>
                    </div>
                </div>
                <div class="skill-category">
                    <h3>Frontend</h3>
                    <div class="skill-tags">
                        <span class="skill-tag">HTML/CSS</span>
                        <span class="skill-tag">JavaScript</span>
                    </div>
                </div>
                <div class="skill-category">
                    <h3>Outils</h3>
                    <div class="skill-tags">
                        <span class="skill-tag--featured skill-tag--git">
                            <img src="/images/git.svg" alt="Git">
                            Git
                        </span>
                        <span class="skill-tag--featured skill-tag--composer">
                            <img src="/images/composer.svg" alt="Composer">
                            Composer
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Expériences -->
    <section id="experience">
        <div class="container">
            <h2 class="section-title">Expériences</h2>
            <div class="timeline">
                <div class="timeline-item">
                    <img src="/images/logo_ponera_blanc.png" alt="" class="timeline-item__logo">
                    <h3>DevOps / Développeur Web Backend</h3>
                    <p class="company">Ponera</p>
                    <p class="period">2024 - Présent</p>
                    <ul>
                        <li>Maintien et modernisation de la base de code</li>
                        <li>Mise en place du système de déploiement CI/CD</li>
                        <li>Mise en place d'une base de données shardée avec Vitess</li>
                        <li>Mise en place du monitoring avec PMM</li>
                        <li>Gestion des serveurs avec Ansible</li>
                    </ul>
                </div>
                <div class="timeline-item">
                    <img src="/images/Ankama_Games_Logo_3.png" alt="" class="timeline-item__logo">
                    <h3>Développeur Web Backend</h3>
                    <p class="company">Ankama, Roubaix</p>
                    <p class="period">2020 - 2024</p>
                    <ul>
                        <li>Maintien et amélioration de la base de code</li>
                        <li>Amélioration et sécurisation des systèmes de connexion</li>
                        <li>Création d'une nouvelle API Scala dédiée à l'e-shop</li>
                        <li>Développement de scripts pour cron</li>
                        <li>Consommation d'APIs externes avec utilisation de SDK</li>
                        <li>Mise à jour des versions de base de données</li>
                    </ul>
                </div>
                <div class="timeline-item">
                    <img src="/images/logo-psi-sansbaseline-shd-2.png" alt="" class="timeline-item__logo">
                    <h3>Développeur Web Fullstack</h3>
                    <p class="company">PSI (Libelule), Bordeaux</p>
                    <p class="period">2019 - 2020</p>
                    <ul>
                        <li>Création de backoffices web et d'API avec Laravel</li>
                        <li>Intégration et développement front avec Blade et VueJS</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Formation -->
    <section id="formation">
        <div class="container">
            <h2 class="section-title">Formation</h2>
            <div class="formation-item">
                <div>
                    <h3>Titre professionnel Développeur Web et Web Mobile</h3>
                    <p class="school">O'Clock</p>
                </div>
                <span class="year">2020</span>
            </div>
            <div class="formation-item">
                <div>
                    <h3>Master Marketing et Communication</h3>
                    <p class="school">Esupcom Lille</p>
                </div>
                <span class="year">2017</span>
            </div>
            <div class="formation-item">
                <div>
                    <h3>Licence Économie et Gestion</h3>
                    <p class="school">IAE Valenciennes</p>
                </div>
                <span class="year">2015</span>
            </div>
        </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="contact-section">
        <div class="container">
            <h2 class="section-title">Contact</h2>
            <p>Disponible pour discuter de vos projets ou opportunités.</p>
            <div class="contact-links">
                <a href="mailto:rodolphewojtko@gmail.com">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                    rodolphewojtko@gmail.com
                </a>
                <a href="https://www.linkedin.com/in/rodolphe-wojtkowiak" target="_blank" rel="noopener">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                    LinkedIn
                </a>
                <a href="https://github.com/Rodow" target="_blank" rel="noopener">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                    </svg>
                    GitHub
                </a>
            </div>
        </div>
    </section>

    <footer>
        <p>&copy; {{ 'now'|date('Y') }} Rodolphe Wojtkowiak</p>
    </footer>
{% endblock %}
