{% extends 'base.html.twig' %}

{% block title %}Rodolphe Wojtkowiak - DevOps / Développeur Web Backend{% endblock %}

{% block body %}
    {#
        Technos affichées en badge.
        major : parmi les plus demandées, affichée en grand dans le pipeline.
        brand : couleur au moment où le badge s'allume.
    #}
    {% set techs = {
        php: {name: 'PHP', logo: 'php.svg', brand: '#777bb4', major: true},
        symfony: {name: 'Symfony', logo: 'symfony.svg', brand: '#ffffff', major: true},
        scala: {name: 'Scala', logo: 'scala.svg', brand: '#dc322f'},
        composer: {name: 'Composer', logo: 'composer.svg', brand: '#885630'},
        github_actions: {name: 'GitHub Actions', logo: 'github-actions.svg', brand: '#2088ff', major: true},
        git: {name: 'Git', logo: 'git.svg', brand: '#f05032'},
        docker: {name: 'Docker', logo: 'docker.svg', brand: '#2496ed', major: true},
        terraform: {name: 'Terraform', logo: 'terraform.svg', brand: '#7b42bc', major: true},
        ansible: {name: 'Ansible', logo: 'ansible_logo_black_square.png', brand: '#ee0000', major: true},
        linux: {name: 'Linux', logo: 'linux.svg', brand: '#fcc624'},
        ovhcloud: {name: 'OVHCloud', brand: '#00d4ff'},
        mysql: {name: 'MySQL', logo: 'mysql.svg', brand: '#00758f', major: true},
        vitess: {name: 'Vitess', logo: 'vitess.png', brand: '#00d88a', major: true},
        clickhouse: {name: 'ClickHouse', logo: 'clickhouse.svg', brand: '#ffcc01'},
        timescaledb: {name: 'TimescaleDB', brand: '#fdb515'},
        grafana: {name: 'Grafana', logo: 'grafana.svg', brand: '#f46800', major: true},
        prometheus: {name: 'Prometheus', logo: 'prometheus.svg', brand: '#e6522c', major: true},
        loki: {name: 'Loki', logo: 'loki.png', brand: '#f4b400'},
        pmm: {name: 'PMM', brand: '#10b981'},
        netdata: {name: 'Netdata', logo: 'netdata.png', brand: '#00ab44'},
    } %}
    <div class="bg-shapes">
        <div class="shape"></div>
        <div class="shape"></div>
        <div class="shape"></div>
    </div>

    <!-- Accueil : profil à gauche, compétences à droite -->
    <section class="hero">
        <div class="container container--wide hero-layout">
            <aside class="hero-profile">
                <img src="/images/photo-rodolphe.jpeg" alt="Rodolphe Wojtkowiak" class="profile-photo">
                <h1>Rodolphe <span>Wojtkowiak</span></h1>
                <p class="subtitle">DevOps / Développeur Web Backend</p>
                <p class="tagline">+6 ans d'expérience en développement, dont 2 en DevOps. Passionné, rigoureux, esprit d'équipe.</p>
                <div class="hero-links">
                    <a href="mailto:rodolphewojtko@gmail.com" class="primary">Me contacter</a>
                    <a href="https://www.linkedin.com/in/rodolphe-wojtkowiak" target="_blank" rel="noopener"
                       class="secondary">LinkedIn</a>
                </div>
            </aside>
            <div id="skills" class="hero-skills">
                <h2 class="pipeline-lead">Du code à la production, avec l'IA à chaque étape</h2>
                {# ai : usage concret de l'IA à cette étape (rail de droite). #}
                {% set pipeline = [
                    {label: 'Code', skills: ['php', 'symfony', 'scala', 'composer'],
                        ai: ['Claude Code, plusieurs agents en parallèle', 'Skills maison : tests, couverture']},
                    {label: 'Intégration continue', skills: ['github_actions', 'git'],
                        ai: ['Revue de code par IA', 'Issue → PR par un agent']},
                    {label: 'Conteneurs', skills: ['docker'],
                        ai: ['Skill de mise en place du déploiement continu']},
                    {label: 'Infrastructure', skills: ['terraform', 'ansible', 'linux', 'ovhcloud'],
                        ai: ['Agents IA pour les power users, déployés par Ansible', 'MCP d\'orchestration : les agents pilotent les crons']},
                    {label: 'Données', skills: ['mysql', 'vitess', 'clickhouse', 'timescaledb'],
                        ai: ['MCP multi-bases en lecture seule (MySQL, ClickHouse…)']},
                    {label: 'Observabilité', skills: ['grafana', 'prometheus', 'loki', 'pmm', 'netdata'],
                        ai: ['Diagnostic d\'incidents par agent (PMM, Netdata, Loki)', 'Suivi des frictions des agents IA']},
                ] %}
                <div class="pipeline-head">
                    <div class="ai-logos">
                        <span class="ai-logos__item"><img src="/images/claude.svg" alt="">Claude Code</span>
                        <span class="ai-logos__item"><img src="/images/gemini.svg" alt="">Gemini</span>
                        <span class="ai-logos__item"><img src="/images/openai.svg" alt="">OpenAI</span>
                    </div>
                </div>
                <ol class="pipeline" data-controller="pipeline" data-pipeline-interval-value="1100">
                    {% for stage in pipeline %}
                        <li class="pipeline-stage" data-pipeline-target="stage">
                            <div class="pipeline-stage__label">
                                <span class="pipeline-stage__step">{{ '%02d'|format(loop.index) }}</span>
                                {{ stage.label }}
                            </div>
                            <div class="pipeline-stage__skills">
                                {% for key in stage.skills %}
                                    {{ include('home/_skill.html.twig', {skill: techs[key]}) }}
                                {% endfor %}
                            </div>
                            <ul class="pipeline-stage__ai">
                                {% for usage in stage.ai %}
                                    <li>{{ usage }}</li>
                                {% endfor %}
                            </ul>
                        </li>
                    {% endfor %}
                </ol>
            </div>
        </div>
        <a href="#experience" class="scroll-indicator" aria-label="Voir les expériences">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
            </svg>
        </a>
    </section>

    {# Tout ce qui suit l'accueil forme un seul point d'accroche du défilement (voir .cv-details). #}
    <div class="cv-details">
    <!-- Expériences : même rail que le pipeline, le poste actuel est l'étape « en cours » -->
    <section id="experience">
        <div class="container container--wide">
            <h2 class="section-title section-title--rail">Expériences</h2>
            {# ai : tâche liée à l'IA, affichée en violet comme le rail IA de l'accueil. #}
            {% set experiences = [
                {title: 'DevOps / Développeur Web Backend', company: 'Ponera', period: '2024 — Présent', current: true,
                    logo: 'logo_ponera_blanc.png',
                    tasks: [
                        {text: 'Gestion de l\'infrastructure dédiée et cloud (OVHcloud, une vingtaine de serveurs) avec Ansible et Terraform'},
                        {text: 'Sécurisation des accès : bastion, VPN WireGuard, pare-feu piloté par Ansible'},
                        {text: 'Conception et exploitation d\'un cluster MySQL shardé avec Vitess : bascules de primaire, optimisation des requêtes lentes'},
                        {text: 'Mise en place de l\'observabilité : PMM, Prometheus, Grafana, Loki, Netdata, alertes Slack'},
                        {text: 'Déploiement continu des applications : GitHub Actions, images Docker, mise en production automatique'},
                        {text: 'Développement d\'un orchestrateur de jobs interne (Symfony) et migration des crons historiques'},
                        {text: 'Mise à disposition d\'agents IA pour les power users, déployés et supervisés par Ansible', ai: true},
                        {text: 'Création d\'une marketplace interne de skills et serveurs MCP pour outiller l\'équipe en IA', ai: true},
                        {text: 'Maintien et modernisation de l\'application PHP historique'},
                    ]},
                {title: 'Développeur Web Backend', company: 'Ankama, Roubaix', period: '2020 — 2024',
                    logo: 'Ankama_Games_Logo_3.png',
                    tasks: [
                        {text: 'Maintien et amélioration de la base de code'},
                        {text: 'Amélioration et sécurisation des systèmes de connexion'},
                        {text: 'Création d\'une nouvelle API Scala dédiée à l\'e-shop'},
                        {text: 'Développement de scripts pour cron'},
                        {text: 'Consommation d\'APIs externes avec utilisation de SDK'},
                        {text: 'Mise à jour des versions de base de données'},
                    ]},
                {title: 'Développeur Web Fullstack', company: 'PSI (Libelule), Bordeaux', period: '2019 — 2020',
                    logo: 'logo-psi-sansbaseline-shd-2.png',
                    tasks: [
                        {text: 'Création de backoffices web et d\'API avec Laravel'},
                        {text: 'Intégration et développement front avec Blade et VueJS'},
                    ]},
            ] %}
            <ol class="career">
                {% for job in experiences %}
                    <li class="career-item{{ job.current is defined ? ' is-current' }}">
                        <div class="career-item__when">
                            <span class="career-item__period">{{ job.period }}</span>
                            {{ job.company }}
                        </div>
                        <article class="career-card">
                            <img src="/images/{{ job.logo }}" alt="" class="career-card__logo">
                            <h3>{{ job.title }}</h3>
                            <ul class="career-card__tasks">
                                {% for task in job.tasks %}
                                    <li{{ task.ai is defined ? ' class="is-ai"' }}>{{ task.text }}</li>
                                {% endfor %}
                            </ul>
                        </article>
                    </li>
                {% endfor %}
            </ol>
        </div>
    </section>

    <!-- Formation : même rail que les expériences -->
    <section id="formation">
        <div class="container container--wide">
            <h2 class="section-title section-title--rail">Formation</h2>
            {% set formations = [
                {title: 'Perfectionnement DevOps : programme intensif de 6 semaines avec mentorat', school: 'Cocadmin', year: '2026'},
                {title: 'Titre professionnel Développeur Web et Web Mobile', school: 'O\'Clock', year: '2020'},
                {title: 'Master Marketing et Communication', school: 'Esupcom Lille', year: '2017'},
                {title: 'Licence Économie et Gestion', school: 'IAE Valenciennes', year: '2015'},
            ] %}
            <ol class="career">
                {% for formation in formations %}
                    <li class="career-item">
                        <div class="career-item__when">
                            <span class="career-item__period">{{ formation.year }}</span>
                            {{ formation.school }}
                        </div>
                        <article class="career-card">
                            <h3>{{ formation.title }}</h3>
                        </article>
                    </li>
                {% endfor %}
            </ol>
        </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="contact-section">
        <div class="container">
            <h2 class="section-title">Contact</h2>
            <p>Disponible pour discuter de vos projets ou opportunités.</p>
            <div class="contact-links">
                <a href="mailto:rodolphewojtko@gmail.com">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                    rodolphewojtko@gmail.com
                </a>
                <a href="https://www.linkedin.com/in/rodolphe-wojtkowiak" target="_blank" rel="noopener">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                    LinkedIn
                </a>
                <a href="https://github.com/Rodow" target="_blank" rel="noopener">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                    </svg>
                    GitHub
                </a>
            </div>
        </div>
    </section>

    <footer>
        <p>&copy; {{ 'now'|date('Y') }} Rodolphe Wojtkowiak</p>
    </footer>
    </div>

    {#
        Trait continu qui relie les rails : point 6 du pipeline → souligne « Expériences » → rail des expériences,
        puis dernier poste → souligne « Formation » → rail de la formation. Tracé en JS (voir site_rail_controller.js).
    #}
    <svg class="site-rail" aria-hidden="true"
         data-controller="site-rail"
         data-site-rail-segments-value="{{ [
             {from: '.pipeline-stage:last-child', title: '#experience .section-title', to: '#experience .career-item:first-child'},
             {from: '#experience .career-item:last-child', title: '#formation .section-title', to: '#formation .career-item:first-child'},
         ]|json_encode|e('html_attr') }}"></svg>
{% endblock %}
