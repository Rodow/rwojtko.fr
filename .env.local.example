# Local environment overrides (not committed)
# Copy this file to .env.local and set real values

# Generate a real secret: openssl rand -hex 16
APP_SECRET=your_real_secret_here

# PostgreSQL credentials for production
# DATABASE_URL="postgresql://user:password@database:5432/dbname?serverVersion=16&charset=utf8"

# Mailer for production (example with SMTP)
# MAILER_DSN=smtp://user:pass@smtp.example.com:587
