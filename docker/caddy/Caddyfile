{
    # Global options
    auto_https off
    admin off
}

:80 {
    root * /var/www/html/public

    # Encode responses with gzip
    encode gzip

    # Handle PHP files
    php_fastcgi php:9000

    # Serve static files directly
    file_server

    # Symfony routing - rewrite all requests to index.php if file doesn't exist
    @notStatic {
        not file
        path_regexp !^/bundles/
    }
    rewrite @notStatic /index.php

    # Logging
    log {
        output stdout
        format console
        level INFO
    }

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        X-XSS-Protection "1; mode=block"
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # Block access to hidden files (except .well-known)
    @hidden {
        path /.*
        not path /.well-known/*
    }
    respond @hidden 404
}
